{
  "name": "accessories-shop",
  "version": "1.0.0",
  "description": "نظام إدارة محل الإكسسوارات",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.shop.accessories",
    "productName": "Accessories Shop",
    "files": ["main.js", "index.html"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
